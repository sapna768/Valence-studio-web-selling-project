# Copy this file to ".env" and fill in real values. Never commit ".env".

# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Gmail account that SENDS the emails (OTP codes + admin notifications).
# Use a Google "App Password" (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where feedback / requirement notifications are delivered. Optional - defaults to GMAIL_USER.
ADMIN_EMAIL=yourname@gmail.com

# Hosting on Render FREE? Render blocks Gmail SMTP there. Use Brevo's HTTPS API instead:
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER=yourname@gmail.com   (must be a verified sender in Brevo)

# Render free deletes the SQLite file on restart. For permanent data use a free Postgres
# (e.g. neon.tech or supabase.com) and paste its connection string here:
# DATABASE_URL=postgresql://user:password@host/dbname

# Production only (when hosted behind Render / Heroku / nginx on https):
# TRUST_PROXY=1
# COOKIE_SECURE=1
